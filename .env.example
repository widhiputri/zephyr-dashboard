# Zephyr Scale API Token (required)
ZEPHYR_API_TOKEN=your-zephyr-scale-api-token

# Server port
PORT=3001

# Cache TTLs (seconds)
CACHE_TTL_PROJECTS=3600
CACHE_TTL_METRICS=300

# Allowed CORS origins for the backend (comma-separated, leave unset to allow all during local dev)
# Example: CORS_ORIGIN=https://qa-dashboard.yourcompany.com
CORS_ORIGIN=

# Project keys that have meaningful team sub-folders (comma-separated)
# Only these projects will show the team filter on the dashboard
# Example: TEAM_PROJECTS=PROJ1,PROJ2
TEAM_PROJECTS=

# Allowlist of team folder names per project — only listed folders appear as team options
# Format: TEAM_FOLDERS_<PROJECT>=FolderName1,FolderName2
# Example: TEAM_FOLDERS_PROJ1=Team A,Team B,Team C
# TEAM_FOLDERS_PROJ1=
